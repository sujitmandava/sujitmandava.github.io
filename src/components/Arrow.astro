---
// Signage arrow, drawn to match the page's 2px-stroke icon family.
interface Props { dir?: 'right' | 'up-right' | 'up' | 'down'; size?: number; class?: string }
const { dir = 'right', size = 18, class: cls } = Astro.props;
const rot = { right: 0, 'up-right': -45, up: -90, down: 90 }[dir];
---
<svg class:list={['arrow-svg', cls]} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" style={`transform: rotate(${rot}deg)`}><path d="M3 12h15M12 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter"/></svg>
